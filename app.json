{
  "expo": {
    "name": "Kawman Field",
    "slug": "kawman-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kawmanfield",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kawmanexact.field",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kawman Field uses your location to verify field visit check-ins."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kawman Field uses the camera for visit proof photos and business card scans.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://kawmanexact-crm.vercel.app",
      "router": {},
      "eas": {
        "projectId": "f6e6d04d-5769-4787-b666-f03f72288de5"
      }
    }
  }
}
