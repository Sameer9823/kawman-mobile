{
  "expo": {
    "name": "Kawmanexact Sales Tracking",
    "slug": "kawman-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kawmanfield",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo-header.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff5f1"
    },
    "android": {
      "package": "com.kawmanexact.field",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#603426",
        "sounds": ["./assets/sounds/visit_alert.wav"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kawmanexact Sales Tracking uses your location to verify field visit check-ins."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kawmanexact Sales Tracking uses the camera for visit proof photos and business card scans.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#603426",
          "sounds": ["./assets/sounds/visit_alert.wav"]
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-audio"
    ],
    "extra": {
      "apiUrl": "https://kawmanexact-crm.vercel.app",
      "router": {},
      "eas": {
        "projectId": "f6e6d04d-5769-4787-b666-f03f72288de5"
      }
    }
  }
}
